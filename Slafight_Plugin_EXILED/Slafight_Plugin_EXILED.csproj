<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ProjectGuid>{38D11BA7-26B0-4C36-9C24-3563A8CE956E}</ProjectGuid>
        <OutputType>Library</OutputType>
        <TargetFramework>net48</TargetFramework>
        <RootNamespace>Slafight_Plugin_EXILED</RootNamespace>
        <AssemblyName>Slafight_Plugin_EXILED</AssemblyName>
        <FileAlignment>512</FileAlignment>
        <LangVersion>default</LangVersion>
        <Nullable>annotations</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <Deterministic>false</Deterministic>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>

    <!--
        SL_References は通常環境変数で与えられるが、未設定の環境でも
        兄弟リポジトリとしてチェックアウトされた SL_References を参照できるようにする。
    -->
    <PropertyGroup Condition=" '$(SL_References)' == '' ">
        <SL_References Condition="Exists('$(MSBuildProjectDirectory)\..\..\SL_References\mscorlib.dll')">$(MSBuildProjectDirectory)\..\..\SL_References</SL_References>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ExMod.Exiled" Version="9.14.2" />
        <PackageReference Include="Lib.Harmony" Version="2.2.2" />
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.1" />
        <PackageReference Include="System.Buffers" Version="4.6.1" />
        <PackageReference Include="System.IO.Pipelines" Version="10.0.1" />
        <PackageReference Include="System.Memory" Version="4.6.3" />
        <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
        <PackageReference Include="System.Text.Encodings.Web" Version="10.0.1" />
        <PackageReference Include="System.Text.Json" Version="10.0.1" />
        <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
        <PackageReference Include="System.ValueTuple" Version="4.6.1" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="System.IO.Compression" />
        <Reference Include="ProjectMER">
            <HintPath>$(SL_References)\ProjectMER.dll</HintPath>
        </Reference>
        <Reference Include="HintServiceMeow-Exiled">
            <HintPath>$(SL_References)\HintServiceMeow-Exiled.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="SNAPI">
            <HintPath>$(SL_References)\SNAPI-HSM.dll</HintPath>
        </Reference>
        <Reference Include="Snake">
            <HintPath>$(SL_References)\Snake.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Assembly-CSharp-firstpass">
            <HintPath>$(SL_References)\Assembly-CSharp-firstpass.dll</HintPath>
        </Reference>
        <Reference Include="Mirror">
            <HintPath>$(SL_References)\Mirror_publicized.dll</HintPath>
        </Reference>
        <Reference Include="Mirror.Components">
            <HintPath>$(SL_References)\Mirror.Components_publicized.dll</HintPath>
        </Reference>
        <Reference Include="mscorlib">
            <HintPath>$(SL_References)\mscorlib.dll</HintPath>
        </Reference>
        <!--
            UnityEngine.AudioModule 等の Unity アセンブリは netstandard 2.1 を参照するため、
            net48 標準の netstandard 2.0 ファサードのままだと CS1705 になる
            （AudioClip.SetData/GetData の Span オーバーロード解決時に発生）。
            サーバー実体と同じ Mono 版 netstandard 2.1 を明示参照して合わせる。
        -->
        <Reference Include="netstandard">
            <HintPath>$(SL_References)\netstandard.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(SL_References)\Newtonsoft.Json.dll</HintPath>
        </Reference>
        <Reference Include="Pooling">
            <HintPath>$(SL_References)\Pooling.dll</HintPath>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(SL_References)\Unity.TextMeshPro.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(SL_References)\UnityEngine.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(SL_References)\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.PhysicsModule">
            <HintPath>$(SL_References)\UnityEngine.PhysicsModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.AnimationModule">
            <HintPath>$(SL_References)\UnityEngine.AnimationModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.AudioModule">
            <HintPath>$(SL_References)\UnityEngine.AudioModule.dll</HintPath>
        </Reference>
        <Reference Include="System" />
        <Reference Include="System.Core" />
        <Reference Include="System.Data" />
        <Reference Include="System.Net" />
        <Reference Include="System.Net.Http" />
        <Reference Include="System.Net.Http.WebRequest" />
        <Reference Include="System.Numerics" />
        <Reference Include="System.Xml" />
    </ItemGroup>

    <ItemGroup>
        <None Include="App.config" />
    </ItemGroup>

    <!--
        %APPDATA% は Windows のみ。Linux では Mono の SpecialFolder.ApplicationData と
        同じ場所（XDG_CONFIG_HOME、既定は $HOME/.config）に EXILED のプラグインツリーがある。
        どちらも解決できない環境ではコピー先が無いのでターゲットごとスキップする。
    -->
    <PropertyGroup>
        <ExiledAppDataDir Condition="'$(APPDATA)' != ''">$(APPDATA)</ExiledAppDataDir>
        <ExiledAppDataDir Condition="'$(ExiledAppDataDir)' == '' And '$(XDG_CONFIG_HOME)' != ''">$(XDG_CONFIG_HOME)</ExiledAppDataDir>
        <ExiledAppDataDir Condition="'$(ExiledAppDataDir)' == '' And '$(HOME)' != ''">$(HOME)/.config</ExiledAppDataDir>
    </PropertyGroup>

    <Target Name="CopyToExiledPlugins" AfterTargets="Build" Condition="'$(ExiledAppDataDir)' != ''">
        <PropertyGroup>
            <ExiledPluginsDir>$(ExiledAppDataDir)\EXILED\Plugins\7778</ExiledPluginsDir>
            <ExiledDependenciesDir>$(ExiledAppDataDir)\EXILED\Plugins\dependencies</ExiledDependenciesDir>
        </PropertyGroup>
        <ItemGroup>
            <ExiledDependencyFiles Include="$(OutputPath)Microsoft.Bcl.AsyncInterfaces.dll" Condition="Exists('$(OutputPath)Microsoft.Bcl.AsyncInterfaces.dll')" />
            <ExiledDependencyFiles Include="$(OutputPath)Newtonsoft.Json.dll" Condition="Exists('$(OutputPath)Newtonsoft.Json.dll')" />
            <ExiledDependencyFiles Include="$(OutputPath)System.Buffers.dll" Condition="Exists('$(OutputPath)System.Buffers.dll')" />
            <ExiledDependencyFiles Include="$(OutputPath)System.IO.Pipelines.dll" Condition="Exists('$(OutputPath)System.IO.Pipelines.dll')" />
            <ExiledDependencyFiles Include="$(OutputPath)System.Memory.dll" Condition="Exists('$(OutputPath)System.Memory.dll')" />
            <ExiledDependencyFiles Include="$(OutputPath)System.Numerics.Vectors.dll" Condition="Exists('$(OutputPath)System.Numerics.Vectors.dll')" />
            <ExiledDependencyFiles Include="$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll" Condition="Exists('$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll')" />
            <ExiledDependencyFiles Include="$(OutputPath)System.Text.Encodings.Web.dll" Condition="Exists('$(OutputPath)System.Text.Encodings.Web.dll')" />
            <ExiledDependencyFiles Include="$(OutputPath)System.Text.Json.dll" Condition="Exists('$(OutputPath)System.Text.Json.dll')" />
            <ExiledDependencyFiles Include="$(OutputPath)System.Threading.Tasks.Extensions.dll" Condition="Exists('$(OutputPath)System.Threading.Tasks.Extensions.dll')" />
            <ExiledDependencyFiles Include="C:\Mono\lib\mono\xbuild\Microsoft\Microsoft.NET.Build.Extensions\net471\lib\System.Net.Http.dll" Condition="Exists('C:\Mono\lib\mono\xbuild\Microsoft\Microsoft.NET.Build.Extensions\net471\lib\System.Net.Http.dll')" />
        </ItemGroup>
        <MakeDir Directories="$(ExiledPluginsDir);$(ExiledDependenciesDir)" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ExiledPluginsDir)" SkipUnchangedFiles="false" />
        <Copy SourceFiles="@(ExiledDependencyFiles)" DestinationFolder="$(ExiledDependenciesDir)" SkipUnchangedFiles="false" />
    </Target>

    <!--
        Linux では net48 のターゲットパックが Microsoft.NETFramework.ReferenceAssemblies
        パッケージとして暗黙に導入される。その mscorlib は上記の Reference:mscorlib と
        競合するが、パッケージ側にファイルバージョンが無いため競合解決で勝者が決まらず、
        パッケージ側が採用されてしまう（netstandard は 2.1 > 2.0 で解決できるため問題ない）。
        採用された net48 参照アセンブリの mscorlib には
        RuntimeFeature.DefaultImplementationsOfInterfaces が存在しないため、
        インターフェースの静的メンバー実装が CS8701 になる。
        サーバー実体（Unity Mono）と同じ mscorlib を明示的に採用し直して Windows と揃える。
    -->
    <Target Name="PreferServerMscorlib" AfterTargets="ResolveAssemblyReferences"
            Condition="Exists('$(SL_References)\mscorlib.dll')">
        <ItemGroup>
            <ReferencePath Remove="@(ReferencePath->WithMetadataValue('Filename', 'mscorlib'))" />
            <ReferencePath Include="$(SL_References)\mscorlib.dll">
                <Private>false</Private>
                <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
            </ReferencePath>
        </ItemGroup>
    </Target>

</Project>
