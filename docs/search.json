---
layout: null
permalink: /search.json
---
{%- assign catalogs = site.pages | where: "layout", "catalog" -%}
[
{%- assign first = true -%}
{%- for p in catalogs -%}
  {%- if p.catalog.search == false -%}{%- continue -%}{%- endif -%}
  {%- assign title_key = p.catalog.title | default: "name" -%}
  {%- assign summary_key = p.catalog.summary | default: "summary" -%}
  {%- for e in site.data[p.catalog.data] -%}
    {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
    {%- assign group_key = p.catalog.group | default: p.catalog.label -%}
{"code":{{ p.code | jsonify }},"type":{{ p.title | jsonify }},"title":{{ e[title_key] | jsonify }},"group":{{ e[group_key] | jsonify }},"summary":{{ e[summary_key] | jsonify }},"tags":{{ e.tags | join: ' ' | jsonify }},"url":{{ p.url | append: '#' | append: e.id | jsonify }}}
  {%- endfor -%}
{%- endfor -%}
]
